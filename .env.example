# Mongo connection used by both REST & gRPC
NEXON_MONGO_HOST=mongodb
NEXON_MONGO_PORT=27017
NEXON_MONGO_USER=root
NEXON_MONGO_PASS=root
NEXON_MONGO_DB=nexon

# gRPC server defaults
GRPC_BIND=[::]:50051
GRPC_GRACE_SECONDS=5

# Cache defaults (in-process; no expiry; verbose logs)
MODEL_CACHE_TTL=0
MODEL_CACHE_LOG=1

# In order for tools like grpcurl to discover the gRPC API at runtime.
ENABLE_REFLECTION=1

# MLFlow settings
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=sample_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=mlflow
MYSQL_DATABASE=mlflow
MYSQL_USER=mlflow_user
MYSQL_PASSWORD=mlflow_password
MYSQL_ROOT_PASSWORD=toor
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_TRACKING_URI=http://localhost:5000
